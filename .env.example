# ── DepGraph environment ────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your CognoDB instance details.
#   cp .env.example .env.local
#
# Never commit `.env.local` — it is git-ignored by default.

# Bolt endpoint of your CognoDB instance, e.g.
#   bolt+s://<tenant>.cognodb.io:7687   (encrypted)
COGNODB_URI=

COGNODB_USERNAME=cognodb

# Keep secret. Server-side only — never referenced from client code.
COGNODB_PASSWORD=

# Optional: database name inside the instance (CognoDB default database
# usually works without setting this).
# COGNODB_DATABASE=neo4j
